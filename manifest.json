{
  "manifest_version": 3,
  "name": "Zokys",
  "version": "3.5.2",
  "description": "Zokys \u2014 prompt.intxt, switch colors, hub modal dismiss, hide hub prompt UI",
  "author": "Zokys",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://zokysvx.lovable.app/*",
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://lovable.dev/*",
    "https://io.eklas.dev/*",
    "https://vibedeals.shop/*",
    "https://dawn-hill-b9bf.oxenv.workers.dev/*",
    "https://trivis.lovable.app/*",
    "https://*.lovable.app/*",
    "https://ai.127hub.com/*",
    "https://*.127hub.com/*"
  ],
  "action": {
    "default_title": "Zokys",
    "default_popup": "index.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "scripts/k9m2vx.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ],
      "js": [
        "scripts/w8r1qt.js",
        "scripts/content/zokys-native-lock.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ],
      "js": [
        "scripts/content/zokys-features-real.js",
        "scripts/content/zokys-ui-polish.js",
        "scripts/content/zokys-lic-unlock.js",
        "scripts/content/trivis-gate.js",
        "scripts/content/trivis-vx-bar.js",
        "scripts/content/zokys-switch-login.js",
        "scripts/content/zokys-global-lock.js",
        "scripts/content/zokys-send-anim.js",
        "scripts/content/zokys-chat-send.js",
        "scripts/content/zokys-download-source.js",
        "scripts/content/zokys-native-lock.js",
        "scripts/content/zokys-remote-theme.js",
        "scripts/content/zokys-label-main.js",
        "scripts/content/zokys-force-stop.js",
        "scripts/content/zokys-hide-hub-prompt-ui.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "styles/*",
        "scripts/*",
        "index.html"
      ],
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ]
    },
    {
      "resources": [
        "methods/*",
        "scripts/*",
        "assets/*",
        "styles/*"
      ],
      "matches": [
        "https://*.lovable.dev/*",
        "https://lovable.dev/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src https://zokysvx.lovable.app https://trivis.lovable.app https://*.lovable.app https://io.eklas.dev https://*.lovable.dev https://api.lovable.dev https://vibedeals.shop https://dawn-hill-b9bf.oxenv.workers.dev; img-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline'; media-src 'self'"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
